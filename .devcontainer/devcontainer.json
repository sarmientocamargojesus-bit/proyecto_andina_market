{
  "name": "Andina Market 360",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m unittest discover -s tests -v && python src/resumen.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "github.vscode-github-actions"]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Sitio (python -m http.server -d docs)" }
  }
}
